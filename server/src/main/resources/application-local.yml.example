# 复制为 application-local.yml 后填写真实连接信息（该文件已被 .gitignore 忽略）
# cp application-local.yml.example application-local.yml
#
# 也可不建文件，改用环境变量：
#   RUDDER_MYSQL_HOST / RUDDER_MYSQL_PORT / RUDDER_MYSQL_DB / RUDDER_MYSQL_USER / RUDDER_MYSQL_PASSWORD
#   RUDDER_REDIS_HOST / RUDDER_REDIS_PORT / RUDDER_REDIS_PASSWORD / RUDDER_REDIS_DB

rudder:
  persistence:
    enabled: true

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/rudder?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: PLEASE_SET_MYSQL_USER
    password: PLEASE_SET_MYSQL_PASSWORD
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password:
      database: 0

logging:
  level:
    com.rudder.server: DEBUG
