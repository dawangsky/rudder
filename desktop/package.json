{
  "name": "rudder-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run build && node dist/scripts/ensure-electron.js",
    "predev": "npm run build && node dist/scripts/ensure-daemon.js",
    "prestart": "npm run build && node dist/scripts/ensure-daemon.js",
    "dev": "electron .",
    "start": "electron .",
    "ensure-daemon": "npm run build && node dist/scripts/ensure-daemon.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "33.2.1",
    "typescript": "~5.7.2"
  }
}
